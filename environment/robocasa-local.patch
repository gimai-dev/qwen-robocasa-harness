+def _required_directory(variable):
+    raw = os.environ.get(variable)
+    if not raw:
+        raise RuntimeError(f"{variable} is required")
+    path = Path(raw)
+    if not path.is_absolute():
+        raise RuntimeError(f"{variable} must be absolute")
+    return path.resolve(strict=True)
+
+
+@lru_cache(maxsize=1)
+def _asset_authority():
+    asset_root = _required_directory("ROBOCASA_ASSET_ROOT")
+    manifest_path = Path(os.environ.get("ROBOCASA_ASSET_MANIFEST", ""))
+    if not manifest_path.is_absolute() or not manifest_path.is_file():
+        raise RuntimeError("ROBOCASA_ASSET_MANIFEST must be an absolute regular file")
+    with manifest_path.open(encoding="utf-8") as stream:
+        records = json.load(stream)
+    paths = frozenset(record["path"] for record in records)
+    return asset_root, paths
+
+
+def _episode_temp_directory():
+    temp_root = _required_directory("ROBOCASA_EPISODE_TMPDIR")
+    run_root = _required_directory("ROBOCASA_RUN_DIR")
+    checkout_root = _required_directory("ROBOCASA_CHECKOUT_ROOT")
+    cache_root = _required_directory("ROBOCASA_CACHE_ROOT")
+    metadata = temp_root.stat()
+    if metadata.st_uid != os.getuid() or (metadata.st_mode & 0o777) != 0o700:
+        raise RuntimeError("episode temp directory must be uid-owned mode 0700")
+    if not temp_root.is_relative_to(run_root):
+        raise RuntimeError("episode temp directory must be inside the run directory")
+    if temp_root.is_relative_to(checkout_root) or temp_root.is_relative_to(cache_root):
+        raise RuntimeError("episode temp directory overlaps an immutable root")
+    if any(temp_root.iterdir()):
+        raise RuntimeError("episode temp directory is not empty")
+    return temp_root
+
+
+def _canonicalize_asset_paths(xml_str, source_xml_path):
+    source_path = Path(source_xml_path).resolve(strict=True)
+    asset_root, manifest_paths = _asset_authority()
+    if not source_path.is_relative_to(asset_root):
+        raise RuntimeError("object XML is outside the locked asset root")
+    root = ET.fromstring(xml_str)
+    if root.findall(".//include"):
+        raise RuntimeError("included XML is not supported by the locked corpus")
+
+    compiler = root.find("compiler")
+    if compiler is None:
+        compiler = ET.Element("compiler")
+        root.insert(0, compiler)
+    strippath = compiler.get("strippath")
+    if strippath is not None and strippath.lower() not in {"false", "0"}:
+        raise RuntimeError("compiler strippath must be false")
+    compiler.set("strippath", "false")
+
+    source_directory = source_path.parent
+    bases = {}
+    assetdir = compiler.get("assetdir")
+    asset_base = source_directory if assetdir is None else source_directory / assetdir
+    for attribute in ("assetdir", "meshdir", "texturedir"):
+        value = compiler.get(attribute)
+        base = asset_base if value is None else source_directory / value
+        resolved = base.resolve(strict=True)
+        if not resolved.is_relative_to(asset_root):
+            raise RuntimeError(f"compiler {attribute} escapes the locked asset root")
+        bases[attribute] = resolved
+        if value is not None:
+            compiler.set(attribute, str(resolved))
+
+    resolved_references = []
+    for element in root.iter():
+        value = element.get("file")
+        if value is None:
+            continue
+        base_attribute = _FILE_TAG_BASE.get(element.tag)
+        if base_attribute is None:
+            raise RuntimeError(f"unrecognized file-bearing element: {element.tag}")
+        candidate = Path(value)
+        resolved = (
+            candidate.resolve(strict=True)
+            if candidate.is_absolute()
+            else (bases[base_attribute] / candidate).resolve(strict=True)
+        )
+        if not resolved.is_relative_to(asset_root):
+            raise RuntimeError(f"asset reference escapes the locked root: {value}")
+        relative = resolved.relative_to(asset_root).as_posix()
+        if relative not in manifest_paths:
+            raise RuntimeError(f"asset reference is not manifest-bound: {relative}")
+        element.set("file", str(resolved))
+        resolved_references.append((element.tag, value, relative))
+    return ET.tostring(root, encoding="utf8").decode("utf8"), resolved_references
+
